{
  "name": "create-restack-pattern",
  "version": "0.2.0",
  "description": "Scaffold a new Next.js + Hono + Drizzle monorepo using the Restack Pattern (Semi-DDD) template.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "create-restack-pattern": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "sync-template": "node scripts/sync-template.mjs",
    "prepublishOnly": "pnpm sync-template && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  }
}
